local TestKit = require("../TestKit")
local Loader = require("../Loader")
local describe, it, expect = TestKit.describe, TestKit.it, TestKit.expect

local Validate = Loader.require("src/shared/Util/Validate")
local RateLimiter = Loader.require("src/shared/Util/RateLimiter")
local Format = Loader.require("src/shared/Util/Format")
local Signal = Loader.require("src/shared/Util/Signal")

describe("Validate", function()
	it("checks ids", function()
		local id = Validate.id(10)
		expect((id("burrow_pack"))).toBe(false) -- 11 chars
		expect((id("pack-1"))).toBe(true)
		expect((id(""))).toBe(false)
		expect((id("a b"))).toBe(false)
		expect((id(5))).toBe(false)
	end)

	it("accepts instance ids for real and Studio test players only", function()
		local check = Validate.instanceId()
		expect((check("123456-7"))).toBe(true)
		expect((check("-1-5"))).toBe(true) -- Studio Clients and Servers players have negative ids
		expect((check("--1-5"))).toBe(false)
		expect((check("1-"))).toBe(false)
		expect((check("../../x"))).toBe(false)
		expect((check("1-2-3"))).toBe(false)
		expect((check(15))).toBe(false)
	end)

	it("checks integers including NaN and infinity", function()
		local int = Validate.integer(1, 10)
		expect((int(5))).toBe(true)
		expect((int(5.5))).toBe(false)
		expect((int(0))).toBe(false)
		expect((int(0 / 0))).toBe(false)
		expect((int(math.huge))).toBe(false)
		expect((int("5"))).toBe(false)
	end)

	it("checks arrays strictly", function()
		local arr = Validate.array(Validate.id(10), 3)
		expect((arr({ "a", "b" }))).toBe(true)
		expect((arr({}))).toBe(false)
		expect((arr({ "a", "b", "c", "d" }))).toBe(false)
		expect((arr({ a = "x" }))).toBe(false)
		expect((arr({ [1] = "a", [3] = "c" }))).toBe(false)
		expect((arr({ "a", 5 }))).toBe(false)
	end)

	it("checks argument counts and positions", function()
		local checkers = { Validate.id(10), Validate.integer(1, 5) }
		expect((Validate.args(checkers, { "x", 2 }, 2))).toBe(true)
		expect((Validate.args(checkers, { "x" }, 1))).toBe(false)
		expect((Validate.args(checkers, { "x", 2, 3 }, 3))).toBe(false)
		local ok, reason = Validate.args(checkers, { "x", 9 }, 2)
		expect(ok).toBe(false)
		expect(string.find(reason, "argument 2", 1, true) ~= nil).toBe(true)
	end)
end)

describe("RateLimiter", function()
	it("allows a burst then refills over time", function()
		local t = 0
		local limiter = RateLimiter.new(2, 3, function()
			return t
		end)
		expect(limiter:allow("p")).toBe(true)
		expect(limiter:allow("p")).toBe(true)
		expect(limiter:allow("p")).toBe(true)
		expect(limiter:allow("p")).toBe(false)
		expect(limiter:allow("other")).toBe(true)
		t = 0.5 -- +1 token
		expect(limiter:allow("p")).toBe(true)
		expect(limiter:allow("p")).toBe(false)
		t = 100 -- refill caps at burst
		for _ = 1, 3 do
			expect(limiter:allow("p")).toBe(true)
		end
		expect(limiter:allow("p")).toBe(false)
	end)
end)

describe("Format", function()
	it("adds commas", function()
		expect(Format.commas(0)).toBe("0")
		expect(Format.commas(999)).toBe("999")
		expect(Format.commas(64893)).toBe("64,893")
		expect(Format.commas(2587976)).toBe("2,587,976")
		expect(Format.commas(-1234.9)).toBe("-1,234")
	end)

	it("abbreviates without rounding up", function()
		expect(Format.short(999)).toBe("999")
		expect(Format.short(1000)).toBe("1K")
		expect(Format.short(1999)).toBe("1.99K")
		expect(Format.short(15600000)).toBe("15.6M")
		expect(Format.short(999999)).toBe("999K")
		expect(Format.short(2.5e12)).toBe("2.5T")
		expect(Format.short(123456, 1e6)).toBe("123,456")
	end)

	it("formats durations", function()
		expect(Format.duration(125)).toBe("2:05")
		expect(Format.duration(3725)).toBe("1:02:05")
	end)
end)

describe("Signal", function()
	it("fires handlers in order and supports disconnect", function()
		local signal = Signal.new()
		local log = {}
		local a = signal:Connect(function(x)
			table.insert(log, "a" .. x)
		end)
		signal:Connect(function(x)
			table.insert(log, "b" .. x)
		end)
		signal:Fire(1)
		a:Disconnect()
		signal:Fire(2)
		expect(log).toEqual({ "a1", "b1", "b2" })
	end)
end)
