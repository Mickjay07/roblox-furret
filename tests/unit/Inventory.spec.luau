local TestKit = require("../TestKit")
local Loader = require("../Loader")
local describe, it, expect = TestKit.describe, TestKit.it, TestKit.expect

local Config = Loader.require("src/shared/Config")
local ProfileSchema = Loader.require("src/shared/Data/ProfileSchema")
local Inventory = Loader.require("src/shared/Logic/Inventory")
local Account = Loader.require("src/shared/Logic/Account")
local Wallet = Loader.require("src/shared/Logic/Wallet")

describe("Inventory", function()
	it("creates unique instance ids from the owner and a persistent serial", function()
		local data = ProfileSchema.defaults()
		local a = Inventory.add(data, 42, "burrow_sable_scout", "Normal", 100)
		local b = Inventory.add(data, 42, "burrow_sable_scout", "Gold", 101)
		expect(a).toBe("42-1")
		expect(b).toBe("42-2")
		expect(data.NextCardSerial).toBe(3)
		expect(data.Cards[b].Variant).toBe("Gold")
	end)

	it("tracks discovery, first-time flags and counts", function()
		local data = ProfileSchema.defaults()
		local _, first = Inventory.add(data, 1, "burrow_sable_scout", "Normal", 5)
		local _, second = Inventory.add(data, 1, "burrow_sable_scout", "Shiny", 6)
		expect(first).toBe(true)
		expect(second).toBe(false)
		local entry = data.Discovered.burrow_sable_scout
		expect(entry.Count).toBe(2)
		expect(entry.First).toBe(5)
		expect(entry.Variants.Shiny).toBe(true)
		expect(data.Stats.CardsObtained).toBe(2)
	end)

	it("rejects unknown cards, bad variants and full backpacks", function()
		local data = ProfileSchema.defaults()
		expect((Inventory.add(data, 1, "nope", "Normal", 0))).toBeNil()
		expect((Inventory.add(data, 1, "burrow_sable_scout", "Plaid", 0))).toBeNil()
		for i = 1, Config.Game.Backpack.BaseCapacity do
			data.Cards["fill-" .. i] =
				{ CardId = "burrow_sable_scout", Variant = "Normal", Obtained = 0, Favorite = false }
		end
		local id, reason = Inventory.add(data, 1, "burrow_sable_scout", "Normal", 0)
		expect(id).toBeNil()
		expect(reason).toBe("backpack full")
		expect((Inventory.add(data, 1, "burrow_sable_scout", "Normal", 0, true)) ~= nil).toBe(true)
	end)

	it("removing a card also clears its display slot", function()
		local data = ProfileSchema.defaults()
		local id = Inventory.add(data, 1, "burrow_sable_scout", "Normal", 0)
		data.Display["2"] = id
		expect(Inventory.displaySlotOf(data, id)).toBe("2")
		expect(Inventory.remove(data, id).CardId).toBe("burrow_sable_scout")
		expect(data.Display["2"]).toBeNil()
		expect(Inventory.owns(data, id)).toBe(false)
		expect(Inventory.remove(data, id)).toBeNil()
	end)
end)

describe("Account", function()
	it("grants the starter bundle exactly once", function()
		local data = ProfileSchema.defaults()
		expect(Account.grantStarter(data, 9, 0)).toBe(true)
		expect(Account.grantStarter(data, 9, 0)).toBe(false)
		expect(data.Currency.Cash).toBe(Config.Economy.StartingCurrency.Cash)
		expect(Inventory.count(data)).toBe(#Config.Economy.StarterCards)
		expect(data.Flags.StarterGranted).toBe(true)
		local Economy = Loader.require("src/shared/Logic/Economy")
		expect(Economy.totalIncome(data) > 0).toBe(true)
	end)

	it("validates settings by key and type", function()
		local data = ProfileSchema.defaults()
		expect((Account.updateSetting(data, "MusicVolume", 0.3))).toBe(true)
		expect(data.Settings.MusicVolume).toBe(0.3)
		expect((Account.updateSetting(data, "MusicVolume", 5))).toBe(false)
		expect((Account.updateSetting(data, "MusicVolume", "loud"))).toBe(false)
		expect((Account.updateSetting(data, "Admin", true))).toBe(false)
		expect((Account.updateSetting(data, 1, true))).toBe(false)
	end)

	it("records joins and play time", function()
		local data = ProfileSchema.defaults()
		Account.recordJoin(data, 100)
		Account.recordJoin(data, 200)
		expect(data.Stats.Joins).toBe(2)
		expect(data.Stats.FirstJoin).toBe(100)
		expect(data.Stats.LastJoin).toBe(200)
		Account.addPlayTime(data, 61.9)
		Account.addPlayTime(data, -5)
		expect(data.Stats.PlayTimeSeconds).toBe(61)
	end)
end)

describe("Wallet", function()
	it("never goes negative and tracks earned/spent cash", function()
		local data = ProfileSchema.defaults()
		Wallet.add(data, "Cash", 100)
		expect(Wallet.spend(data, "Cash", 150)).toBe(false)
		expect(Wallet.balance(data, "Cash")).toBe(100)
		expect(Wallet.spend(data, "Cash", 40)).toBe(true)
		expect(Wallet.balance(data, "Cash")).toBe(60)
		expect(data.Stats.CashEarned).toBe(100)
		expect(data.Stats.CashSpent).toBe(40)
		expect(Wallet.canAfford(data, "Cash", 0 / 0)).toBe(false)
		expect(Wallet.canAfford(data, "Cash", -1)).toBe(false)
		expect(function()
			Wallet.add(data, "Cash", -5)
		end).toThrow()
	end)
end)
